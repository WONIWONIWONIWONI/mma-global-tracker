// Cloudflare Worker 설정. 무료 플랜 전용(유료 기능은 쓰지 않는다).
// 투표가 끝나 수집·API·데이터베이스를 모두 없앴다. 이제 site/ 폴더의 정적 파일만 내보낸다(무료·무제한, Worker 요청 한도를 쓰지 않음).
{
  "name": "mma-global-tracker",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./site" },
  // 예전 1분 수집 예약을 지운다(빈 목록이어야 Cloudflare 쪽 예약도 없어진다)
  "triggers": { "crons": [] }
}
