{
  "name": "mma-global-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled --port 8787",
    "deploy": "git pull --ff-only && wrangler deploy",
    "db:init:local": "wrangler d1 execute mma-tracker --local --file worker/schema.sql",
    "db:init:remote": "wrangler d1 execute mma-tracker --remote --file worker/schema.sql"
  },
  "devDependencies": {
    "wrangler": "4.155.0"
  },
  "allowScripts": {
    "workerd@1.20261023.1": true,
    "esbuild@0.28.2": true
  }
}
